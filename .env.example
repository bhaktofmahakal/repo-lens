# utsav
# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GITHUB_LOGIN=false
NEXT_PUBLIC_ENABLE_GITHUB_CONNECT=false
NEXT_PUBLIC_ENABLE_STRIPE_BILLING=false
NEXT_PUBLIC_ENABLE_GITHUB_AUTOSYNC=false
NEXT_PUBLIC_GITHUB_APP_SLUG=your-github-app-slug

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRO_PRICE_ID=price_xxx_pro
STRIPE_TEAM_PRICE_ID=price_xxx_team
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# GitHub token encryption key (used to encrypt private-repo OAuth tokens at rest)
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----"

# Groq
GROQ_API_KEY=your-groq-api-key

# Hugging Face
HF_TOKEN=your-hf-token
HF_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Limits
MAX_ZIP_SIZE_MB=25
MAX_TOTAL_FILES=1000
MAX_TOTAL_CHARS=4000000
MAX_FILE_CHARS=200000
GITHUB_FETCH_CONCURRENCY=6
EMBEDDING_DIMENSION=768
DEFAULT_CITATION_LIMIT=5
DEFAULT_SNIPPET_LIMIT=8
